@model LibraryMS.Models.LibraryProfile

@{
    ViewData["Title"] = "Create Library Profile";
}

<div class="form-page">
    <h2>Create Library Profile</h2>
    <form asp-action="CreateProfile" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Location"></label>
            <input asp-for="Location" class="form-control" />
            <span asp-validation-for="Location" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="OperatingHours"></label>
            <input asp-for="OperatingHours" class="form-control" placeholder="e.g. Mon-Fri 9am-5pm" />
            <span asp-validation-for="OperatingHours" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="ContactPhone"></label>
            <input asp-for="ContactPhone" class="form-control" />
            <span asp-validation-for="ContactPhone" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="ContactEmail"></label>
            <input asp-for="ContactEmail" class="form-control" />
            <span asp-validation-for="ContactEmail" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="LoanDurationDays"></label>
            <input asp-for="LoanDurationDays" class="form-control" type="number" />
        </div>
        <div class="form-group">
            <label asp-for="MaxRenewals"></label>
            <input asp-for="MaxRenewals" class="form-control" type="number" />
        </div>
        <div class="form-group">
            <label asp-for="MaxBorrowableItems"></label>
            <input asp-for="MaxBorrowableItems" class="form-control" type="number" />
        </div>
        <div class="form-group">
            <label asp-for="DailyFineRate"></label>
            <input asp-for="DailyFineRate" class="form-control" type="number" step="0.01" />
        </div>

        <button type="submit" class="btn-auth">Save Profile</button>
    </form>
</div>