@model LibraryMS.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="auth-container">
    <div class="auth-box">
        <h2>Library MS</h2>
        <p class="auth-subtitle">Create your account</p>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="FullName">Full Name</label>
                <input asp-for="FullName" class="form-control" placeholder="Enter your full name" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" class="form-control" placeholder="Create a password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword">Confirm Password</label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm your password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Role">Register as</label>
                <select asp-for="Role" class="form-control">
                    <option value="Member">Library Member</option>
                    <option value="Librarian">Librarian</option>
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-auth">Create Account</button>

            <p class="auth-link">
                Already have an account? <a asp-action="Login">Sign in here</a>
            </p>
        </form>
    </div>
</div>